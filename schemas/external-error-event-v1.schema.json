{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:auto-error-handler:schema:external-error-event:1.0",
  "title": "Auto Error Handler HTTP Error Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specVersion",
    "eventId",
    "serviceKey",
    "environment",
    "occurredAt",
    "severity",
    "title",
    "message",
    "fingerprint"
  ],
  "properties": {
    "specVersion": { "const": "1.0" },
    "eventId": { "type": "string", "format": "uuid" },
    "serviceKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$"
    },
    "environment": {
      "enum": ["production", "staging", "development", "test"]
    },
    "occurredAt": { "type": "string", "format": "date-time" },
    "severity": { "enum": ["warning", "error", "critical"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "message": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "fingerprint": { "type": "string", "minLength": 1, "maxLength": 200 },
    "exception": { "$ref": "#/$defs/exception" },
    "release": { "$ref": "#/$defs/release" },
    "request": { "$ref": "#/$defs/request" },
    "reproduction": { "$ref": "#/$defs/reproduction" },
    "reproductionData": { "$ref": "#/$defs/reproductionData" },
    "tags": {
      "type": "object",
      "maxProperties": 50,
      "propertyNames": { "minLength": 1, "maxLength": 64 },
      "additionalProperties": { "type": "string", "maxLength": 256 }
    }
  },
  "$defs": {
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "maxLength": 256 },
        "message": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "stackTrace": { "type": "string", "maxLength": 65536 }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "type": "string", "minLength": 1, "maxLength": 200 },
        "commitSha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
        },
        "route": { "type": "string", "maxLength": 500 },
        "statusCode": { "type": "integer", "minimum": 100, "maximum": 599 }
      }
    },
    "reproductionData": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["request"] },
        { "required": ["fixtures"] },
        { "required": ["featureFlags"] }
      ],
      "properties": {
        "request": { "$ref": "#/$defs/reproductionRequest" },
        "fixtures": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/reproductionFixture" }
        },
        "featureFlags": { "$ref": "#/$defs/jsonObject" }
      }
    },
    "reproductionRequest": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["pathParams"] },
        { "required": ["query"] },
        { "required": ["headers"] },
        { "required": ["body"] }
      ],
      "properties": {
        "pathParams": { "$ref": "#/$defs/jsonObject" },
        "query": { "$ref": "#/$defs/jsonObject" },
        "headers": {
          "type": "object",
          "maxProperties": 20,
          "propertyNames": {
            "pattern": "^(content-type|accept|x-fixture-[a-z0-9-]{1,40}|x-test-[a-z0-9-]{1,40})$"
          },
          "additionalProperties": { "type": "string", "maxLength": 256 }
        },
        "body": { "$ref": "#/$defs/jsonValue" }
      }
    },
    "reproductionFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "data"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "data": { "$ref": "#/$defs/jsonValue" }
      }
    },
    "jsonObject": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": { "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "jsonValue": {
      "anyOf": [
        { "type": "string", "maxLength": 4096 },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        { "$ref": "#/$defs/jsonObject" }
      ]
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "preconditions": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "steps": {
          "type": "array",
          "maxItems": 30,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "sanitizedInputs": {
          "type": "object",
          "maxProperties": 50,
          "propertyNames": { "minLength": 1, "maxLength": 64 },
          "additionalProperties": {
            "anyOf": [
              { "type": "string", "maxLength": 1000 },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "null" }
            ]
          }
        },
        "expectedBehavior": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "actualBehavior": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "frequency": { "enum": ["always", "intermittent", "once", "unknown"] }
      }
    }
  }
}
